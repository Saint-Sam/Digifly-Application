include README.md
include CONTRIBUTING.md
include main.py
include pyproject.toml
include pysidedeploy.spec
include docs/ARCHITECTURE.md
include docs/DEPLOYMENT.md
include docs/DEVELOPMENT_PLAN.md
include docs/PACKAGING_BOUNDARY.md
include docs/PHASE1_ACCEPTANCE.md
include docs/PHASE2_ACCEPTANCE.md
