{
  "name": "DigiFly Workstation browser session",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "digifly",
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "DigiFly Workstation",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "overrideCommand": false,
  "init": true
}
